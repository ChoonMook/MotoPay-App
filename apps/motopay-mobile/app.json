{
  "expo": {
    "name": "모토페이",
    "slug": "motopay-customer",
    "version": "0.0.0.16",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.motopay.customer"
    },
    "android": {
      "package": "com.motopay.customer",
      "versionCode": 16,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "앨범에서 사진을 선택하기 위해 접근 권한이 필요해요.",
          "cameraPermission": "사진 촬영을 위해 카메라 접근 권한이 필요해요."
        }
      ],
      [
        "expo-notifications"
      ],
      "./plugins/withTelQueries.js"
    ],
    "extra": {
      "eas": {
        "projectId": "2cb144fa-d014-4622-9407-b621e2ff0749"
      }
    },
    "owner": "choonmook"
  }
}
