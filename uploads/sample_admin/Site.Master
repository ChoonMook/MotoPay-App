<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="partners_admin.SiteMaster" %>
<!DOCTYPE html>
<html lang="ko">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>메타원스 | 파트너스지원시스템</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Malgun Gothic', '맑은 고딕', 'Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'] },
                    colors: {
                        primary: '#3b7ddd', secondary: '#222e3c', tertiary: '#1cbb8c',
                        surface: '#f5f7fb', 'surface-dim': '#e3e6f0',
                        'surface-container-lowest': '#ffffff', 'surface-container-low': '#f8f9fa',
                        'surface-container': '#e9ecef', 'surface-container-high': '#dee2e6',
                        'surface-container-highest': '#ced4da',
                        'on-surface': '#495057', 'on-surface-variant': '#6c757d',
                        outline: '#adb5bd', 'outline-variant': '#dee2e6',
                    }
                }
            }
        };
    </script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <style>
        /* [공통] 스티키 헤더 테이블 렌더링 및 스크롤 비침 완벽 차단용 글로벌 스타일 */
        .sticky-table, table:has(thead.sticky), table:has(thead [class*="sticky"]) {
            border-collapse: separate !important;
            border-spacing: 0 !important;
        }

        .sticky-table th, .sticky-table td,
        table:has(thead.sticky) th, table:has(thead.sticky) td,
        table:has(thead [class*="sticky"]) th, table:has(thead [class*="sticky"]) td {
            border-top: none !important;
            border-left: none !important;
            border-right: 1px solid #dee2e6 !important;
            border-bottom: 1px solid #dee2e6 !important;
            background-clip: padding-box !important;
        }

        .sticky-table th:first-child, .sticky-table td:first-child,
        table:has(thead.sticky) th:first-child, table:has(thead.sticky) td:first-child,
        table:has(thead [class*="sticky"]) th:first-child, table:has(thead [class*="sticky"]) td:first-child {
            border-left: 1px solid #dee2e6 !important;
        }

        .sticky-table thead tr:first-child th,
        table:has(thead.sticky) thead tr:first-child th,
        table:has(thead [class*="sticky"]) thead tr:first-child th {
            border-top: 1px solid #dee2e6 !important;
        }

        .sticky-table thead th,
        table:has(thead.sticky) thead th,
        table:has(thead [class*="sticky"]) thead th {
            position: sticky !important;
            top: 0 !important;
            z-index: 10 !important;
            background-color: #F4F6F9 !important;
        }

        .sticky-table tfoot,
        table:has(thead.sticky) tfoot,
        table:has(thead [class*="sticky"]) tfoot {
            position: sticky !important;
            bottom: 0 !important;
            z-index: 10 !important;
        }
        .sticky-table tfoot td,
        table:has(thead.sticky) tfoot td,
        table:has(thead [class*="sticky"]) tfoot td {
            background-color: #F4F6F9 !important;
        }

        /* 초기 깜빡임 방지 */
        html { background-color: #f5f7fb !important; }
        body { font-family: 'Malgun Gothic', '맑은 고딕', sans-serif; background-color: #f5f7fb !important; color: #495057; -webkit-font-smoothing: antialiased; }
        
        /* 깜빡임 방지용 숨김 클래스 */
        .fouc-hidden { display: none !important; }

        .custom-scrollbar::-webkit-scrollbar { width: 8px; height: 8px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(0,0,0,.15); border-radius: 8px; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .sidebar-transition { transition: width 0.3s; }
        
        .nav-active { 
            background: #1a232e !important; 
            color: #ffffff !important; 
            border-left: none !important;
            font-weight: 600 !important;
        }
        .nav-active i { color: #3b7ddd !important; }
        .nav-active .nav-dot { background-color: #3b7ddd !important; }

        .tab-active {
            background-color: #f1f3f5 !important;
            color: #1a232e !important;
            font-weight: 800 !important;
            border-left: none !important;
            border-top-left-radius: 0.5rem;
            border-top-right-radius: 0.5rem;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        }
        .tab-inactive { background-color: transparent !important; color: #adb5bd !important; font-weight: 600 !important; border-left: 4px solid transparent !important; }
        .tab-inactive:hover { color: #495057 !important; }

        .ui-sortable-placeholder { background: #e9ecef; visibility: visible !important; border-radius: 10px 10px 0 0; border: 1px dashed #adb5bd; }
        
        <% if (this.IsFrame) { %>
        #sidebar, header, #tabs-bar-container { display: none !important; }
        main { padding: 0 !important; }
        body { background: white !important; }
        <% } %>
    </style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form runat="server" class="flex h-screen overflow-hidden bg-surface">
        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="jQuery" />
            </Scripts>
        </asp:ScriptManager>
        <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

        <% if (!IsFrame) { %>
        <aside id="sidebar" class="sidebar-transition w-64 bg-secondary flex flex-col h-full shrink-0 z-50 shadow-[2px_0_8px_rgba(0,0,0,.2)] overflow-hidden">
            <div class="h-16 flex items-center justify-center px-5 gap-3 shrink-0 cursor-pointer hover:bg-black/10 transition-colors" onclick="openTab('/Dashboard.aspx', '대시보드')">
                <img src="/Content/images/metaonce_main.svg" alt="MetaOnce" class="w-8 h-8 object-contain" />
                <span class="sidebar-text text-lg font-bold text-[#e9ecef] whitespace-nowrap">MetaOnce</span>
            </div>
            
            <nav class="flex-1 px-0 py-2 overflow-y-auto custom-scrollbar">
                <a href="javascript:void(0);" onclick="openTab('/Dashboard.aspx', '대시보드')" class="flex items-center gap-3 px-6 py-3 border-l-4 border-transparent text-[#adb5bd] hover:text-[#e9ecef] hover:bg-[#2b394a] transition-all group nav-item" style="display: none;" data-id="/Dashboard.aspx" data-pgid="W000000" menu-id="W000000">
                    <i data-lucide="layout-dashboard" class="w-[18px] h-[18px] shrink-0"></i>
                    <span class="sidebar-text text-xs font-medium">대시보드</span>
                </a>

                <div class="mt-1 border-t border-white/10 pt-1" style="display: none;" data-level="1">
                    <button type="button" class="w-full flex items-center gap-3 px-6 py-3 border-l-4 border-transparent text-[#adb5bd] hover:text-[#e9ecef] hover:bg-[#2b394a] transition-all group outline-none" onclick="toggleSubmenu('submenu-install')">
                        <i data-lucide="clipboard-list" class="w-[18px] h-[18px] shrink-0"></i>
                        <div class="flex-1 flex items-center justify-between sidebar-text">
                            <span class="text-xs font-medium">시공관리</span>
                            <i data-lucide="chevron-down" class="w-3.5 h-3.5 transition-transform duration-200" id="icon-install"></i>
                        </div>
                    </button>
                    <div id="submenu-install" class="fouc-hidden pl-0 mt-1">
                        <a href="javascript:void(0);" onclick="openTab('/Install/InstallReq.aspx', '시공요청서관리')" class="flex items-center gap-3 px-10 py-3 text-[#adb5bd] hover:text-[#e9ecef] transition-all text-xs tracking-tight nav-sub-item" style="display: none;" data-id="/Install/InstallReq.aspx" data-pgid="W010000" menu-id="W010000">
                            <div class="nav-dot w-1.5 h-1.5 rounded-full bg-[#adb5bd]/30 group-hover:bg-[#adb5bd]"></div>
                            <span class="sidebar-text">시공요청서관리</span>
                        </a>
                        <a href="javascript:void(0);" onclick="openTab('/Install/InstallSettle.aspx', '틴팅 시공 정산내역')" class="flex items-center gap-3 px-10 py-3 text-[#adb5bd] hover:text-[#e9ecef] transition-all text-xs tracking-tight nav-sub-item" style="display: none;" data-id="/Install/InstallSettle.aspx" data-pgid="W010100" menu-id="W010100">
                            <div class="nav-dot w-1.5 h-1.5 rounded-full bg-[#adb5bd]/30 group-hover:bg-[#adb5bd]"></div>
                            <span class="sidebar-text">틴팅 시공 정산내역</span>
                        </a>
                    </div>
                </div>

                <div class="mt-1 border-t border-white/10 pt-1" style="display: none;" data-level="1">
                    <button type="button" class="w-full flex items-center gap-3 px-6 py-3 border-l-4 border-transparent text-[#adb5bd] hover:text-[#e9ecef] hover:bg-[#2b394a] transition-all group outline-none" onclick="toggleSubmenu('submenu-coll')">
                        <i data-lucide="wallet" class="w-[18px] h-[18px] shrink-0"></i>
                        <div class="flex-1 flex items-center justify-between sidebar-text">
                            <span class="text-xs font-medium">수금관리</span>
                            <i data-lucide="chevron-down" class="w-3.5 h-3.5 transition-transform duration-200" id="icon-coll"></i>
                        </div>
                    </button>
                    <div id="submenu-coll" class="fouc-hidden pl-0 mt-1">
                        <a href="javascript:void(0);" onclick="openTab('/Collection/DepositList.aspx', '입금내역관리')" class="flex items-center gap-3 px-10 py-3 text-[#adb5bd] hover:text-[#e9ecef] transition-all text-xs tracking-tight nav-sub-item" style="display: none;" data-id="/Collection/DepositList.aspx" data-pgid="W030100" menu-id="W030100">
                            <div class="nav-dot w-1.5 h-1.5 rounded-full bg-[#adb5bd]/30 group-hover:bg-[#adb5bd]"></div>
                            <span class="sidebar-text">입금내역관리</span>
                        </a>
                    </div>
                </div>

                <div class="mt-1 border-t border-white/10 pt-1" style="display: none;" data-level="1">
                    <button type="button" class="w-full flex items-center gap-3 px-6 py-3 border-l-4 border-transparent text-[#adb5bd] hover:text-[#e9ecef] hover:bg-[#2b394a] transition-all group outline-none" onclick="toggleSubmenu('submenu-cust')">
                        <i data-lucide="users" class="w-[18px] h-[18px] shrink-0"></i>
                        <div class="flex-1 flex items-center justify-between sidebar-text">
                            <span class="text-xs font-medium">고객관리</span>
                            <i data-lucide="chevron-down" class="w-3.5 h-3.5 transition-transform duration-200" id="icon-cust"></i>
                        </div>
                    </button>
                    <div id="submenu-cust" class="fouc-hidden pl-0 mt-1">
                        <a href="javascript:void(0);" onclick="openTab('/Customer/CustomerList.aspx', '고객관리')" class="flex items-center gap-3 px-10 py-3 text-[#adb5bd] hover:text-[#e9ecef] transition-all text-xs tracking-tight nav-sub-item" style="display: none;" data-id="/Customer/CustomerList.aspx" data-pgid="W040100" menu-id="W040100">
                            <div class="nav-dot w-1.5 h-1.5 rounded-full bg-[#adb5bd]/30 group-hover:bg-[#adb5bd]"></div>
                            <span class="sidebar-text">고객관리</span>
                        </a>
                    </div>
                </div>

                <div class="mt-1 border-t border-white/10 pt-1" style="display: none;" data-level="1">
                    <button type="button" class="w-full flex items-center gap-3 px-6 py-3 border-l-4 border-transparent text-[#adb5bd] hover:text-[#e9ecef] hover:bg-[#2b394a] transition-all group outline-none" onclick="toggleSubmenu('submenu-sys')">
                        <i data-lucide="settings" class="w-[18px] h-[18px] shrink-0"></i>
                        <div class="flex-1 flex items-center justify-between sidebar-text">
                            <span class="text-xs font-medium">시스템설정</span>
                            <i data-lucide="chevron-down" class="w-3.5 h-3.5 transition-transform duration-200" id="icon-sys"></i>
                        </div>
                    </button>
                    <div id="submenu-sys" class="fouc-hidden pl-0 mt-1">
                        <a href="javascript:void(0);" onclick="openTab('/system/code', '코드관리')" class="flex items-center gap-3 px-10 py-3 text-[#adb5bd] hover:text-[#e9ecef] transition-all text-xs tracking-tight nav-sub-item" style="display: none;" data-id="/system/code" data-pgid="W020100" menu-id="W020100">
                            <div class="nav-dot w-1.5 h-1.5 rounded-full bg-[#adb5bd]/30 group-hover:bg-[#adb5bd]"></div>
                            <span class="sidebar-text">코드관리</span>
                        </a>
                        <a href="javascript:void(0);" onclick="openTab('/system/user', '사용자관리')" class="flex items-center gap-3 px-10 py-3 text-[#adb5bd] hover:text-[#e9ecef] transition-all text-xs tracking-tight nav-sub-item" style="display: none;" data-id="/system/user" data-pgid="W020200" menu-id="W020200">
                            <div class="nav-dot w-1.5 h-1.5 rounded-full bg-[#adb5bd]/30 group-hover:bg-[#adb5bd]"></div>
                            <span class="sidebar-text">사용자관리</span>
                        </a>
                        <a href="javascript:void(0);" onclick="openTab('/system/menuAuth', '메뉴권한관리')" class="flex items-center gap-3 px-10 py-3 text-[#adb5bd] hover:text-[#e9ecef] transition-all text-xs tracking-tight nav-sub-item" style="display: none;" data-id="/system/menuAuth" data-pgid="W020300" menu-id="W020300">
                            <div class="nav-dot w-1.5 h-1.5 rounded-full bg-[#adb5bd]/30 group-hover:bg-[#adb5bd]"></div>
                            <span class="sidebar-text">메뉴권한관리</span>
                        </a>
                        <a href="javascript:void(0);" onclick="openTab('/system/template', 'UI 템플릿')" class="flex items-center gap-3 px-10 py-3 text-[#adb5bd] hover:text-[#e9ecef] transition-all text-xs tracking-tight nav-sub-item" style="display: none;" data-id="/system/template" data-pgid="W020400" menu-id="W020400">
                            <div class="nav-dot w-1.5 h-1.5 rounded-full bg-[#adb5bd]/30 group-hover:bg-[#adb5bd]"></div>
                            <span class="sidebar-text">UI 템플릿</span>
                        </a>
                        <a href="javascript:void(0);" onclick="openTab('/system/holiday', '공휴일관리')" class="flex items-center gap-3 px-10 py-3 text-[#adb5bd] hover:text-[#e9ecef] transition-all text-xs tracking-tight nav-sub-item" style="display: none;" data-id="/system/holiday" data-pgid="W020500" menu-id="W020500">
                            <div class="nav-dot w-1.5 h-1.5 rounded-full bg-[#adb5bd]/30 group-hover:bg-[#adb5bd]"></div>
                            <span class="sidebar-text">공휴일관리</span>
                        </a>
                        <a href="javascript:void(0);" onclick="openTab('/system/notice', '공지사항 관리')" class="flex items-center gap-3 px-10 py-3 text-[#adb5bd] hover:text-[#e9ecef] transition-all text-xs tracking-tight nav-sub-item" style="display: none;" data-id="/system/notice" data-pgid="W020600" menu-id="W020600">
                            <div class="nav-dot w-1.5 h-1.5 rounded-full bg-[#adb5bd]/30 group-hover:bg-[#adb5bd]"></div>
                            <span class="sidebar-text">공지사항 관리</span>
                        </a>
                    </div>
                </div>
            </nav>
            <div class="sidebar-text px-5 py-4 text-center text-[10px] text-white/40 font-medium whitespace-nowrap opacity-60">Copyright ⓒ 2026 MetaOnce</div>
        </aside>

        <div class="flex-1 flex flex-col min-w-0 h-full overflow-hidden">
            <header class="h-16 bg-white border-b border-outline-variant flex items-center justify-between px-6 shrink-0 z-40 shadow-[0_1px_4px_rgba(0,0,0,.06)]">
                <div class="flex items-center gap-4">
                    <button type="button" onclick="toggleSidebar()" class="p-2 rounded-lg text-on-surface hover:bg-surface-container transition-colors"><i data-lucide="menu" class="w-[22px] h-[22px]"></i></button>
                    <span class="font-bold text-secondary text-sm">파트너스지원시스템</span>
                </div>
                <div class="flex items-center gap-3">
                    <button type="button" class="p-2 rounded-full text-on-surface-variant hover:bg-surface-container relative"><i data-lucide="bell" class="w-[18px] h-[18px]"></i><span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span></button>
                    <div class="w-px h-5 bg-outline-variant mx-1"></div>
                    <div class="relative group">
                        <button type="button" class="flex items-center gap-2 p-2 rounded-xl text-on-surface hover:bg-surface-container transition-colors outline-none">
                            <span class="text-xs font-bold"><%= LoginUserName %> 님</span>
                            <i data-lucide="chevron-down" class="w-[15px] h-[15px]"></i>
                        </button>
                        <!-- pt-1(패딩)을 주어 마우스 이동 시 호버가 풀리지 않게 다리 역할 수행 -->
                        <div class="absolute right-0 top-full pt-1 w-44 hidden group-hover:block z-[60]">
                            <div class="bg-white rounded-xl shadow-xl border border-outline-variant overflow-hidden py-1">
                                <a href="javascript:void(0);" onclick="openMyProfile()" class="flex items-center gap-3 px-4 py-2.5 hover:bg-surface-container text-xs font-bold text-secondary border-b border-outline-variant/30"><i data-lucide="user-cog" class="w-4 h-4 text-outline"></i> 내 정보 수정</a>
                                <a href="javascript:void(0);" onclick="showLogoutModal()" class="flex items-center gap-3 px-4 py-2.5 hover:bg-red-50 text-xs font-bold text-red-500"><i data-lucide="log-out" class="w-4 h-4"></i> 로그아웃</a>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <%-- MY PROFILE MODAL --%>
            <div id="modal-my-profile" class="fixed inset-0 bg-secondary/60 backdrop-blur-sm z-[1000] hidden items-center justify-center p-4">
                <div class="bg-white rounded-2xl max-w-[400px] w-full shadow-2xl transform transition-all scale-95 opacity-0 flex flex-col overflow-hidden" id="modal-my-profile-content">
                    <div class="px-8 py-5 border-b border-outline-variant flex items-center justify-between bg-surface-container-lowest">
                        <h3 class="text-base font-bold text-secondary flex items-center gap-3">
                            <span class="p-2 bg-primary/10 text-primary rounded-lg"><i data-lucide="user-cog" class="w-5 h-5"></i></span>
                            <span>내 정보 수정</span>
                        </h3>
                        <button type="button" onclick="closeMyProfile()" class="p-2 text-outline hover:text-secondary hover:bg-surface-container rounded-full transition-all"><i data-lucide="x" class="w-5 h-5"></i></button>
                    </div>
                    <div class="p-6 space-y-4">
                        <div class="grid grid-cols-2 gap-4">
                            <div class="space-y-1.5">
                                <label class="text-[11px] font-bold text-outline uppercase tracking-wider">사용자 아이디</label>
                                <input type="text" id="my-id" readonly class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-4 py-1.5 text-xs outline-none text-on-surface-variant cursor-default" value="<%= LoginUserId %>" />
                            </div>
                            <div class="space-y-1.5">
                                <label class="text-[11px] font-bold text-outline uppercase tracking-wider">사용자 이름</label>
                                <input type="text" id="my-nm" readonly class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-4 py-1.5 text-xs outline-none text-on-surface-variant cursor-default" value="<%= LoginUserName %>" />
                            </div>
                        </div>
                        <div class="space-y-1.5 pt-2 border-t border-outline-variant/30">
                            <label class="text-xs font-bold text-on-surface">새 비밀번호</label>
                            <input type="password" id="my-pwd" class="w-full bg-white border border-outline-variant rounded-lg px-4 py-1.5 text-xs outline-none focus:border-primary transition-all" placeholder="변경 시에만 입력하세요" />
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-xs font-bold text-on-surface">비밀번호 확인</label>
                            <input type="password" id="my-pwd-confirm" class="w-full bg-white border border-outline-variant rounded-lg px-4 py-1.5 text-xs outline-none focus:border-primary transition-all" placeholder="비밀번호를 한번 더 입력하세요" />
                        </div>
                        <div class="space-y-1.5 pt-2 border-t border-outline-variant/30">
                            <label class="text-xs font-bold text-on-surface">휴대폰번호</label>
                            <input type="text" id="my-mobile" class="w-full bg-white border border-outline-variant rounded-lg px-4 py-1.5 text-xs outline-none focus:border-primary transition-all" placeholder="010-0000-0000" />
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-xs font-bold text-on-surface">이메일 주소</label>
                            <input type="text" id="my-email" class="w-full bg-white border border-outline-variant rounded-lg px-4 py-1.5 text-xs outline-none focus:border-primary transition-all" placeholder="example@email.com" />
                        </div>
                    </div>
                    <div class="px-6 py-4 bg-surface-container-lowest border-t border-outline-variant flex gap-2 justify-end">
                        <button type="button" onclick="closeMyProfile()" class="px-5 py-1.5 bg-white border border-outline-variant text-on-surface font-bold rounded-lg text-xs hover:bg-surface-container transition-all">취소</button>
                        <button type="button" onclick="saveMyProfile()" class="flex items-center gap-2 px-6 py-1.5 bg-primary text-white font-bold rounded-lg text-xs hover:opacity-90 transition-all shadow-md shadow-primary/20"><i data-lucide="save" class="w-4 h-4"></i>저장</button>
                    </div>
                </div>
            </div>
            
            <%-- TABS BAR --%>
            <div id="tabs-bar-container" class="bg-white px-6 pt-3 border-b border-outline-variant/50 flex items-center gap-1 shrink-0 overflow-hidden">
                <div id="tabs-bar" class="flex-1 flex items-center gap-1 overflow-x-auto no-scrollbar"></div>
                <button type="button" onclick="showCloseAllModal()" class="mb-1 p-1.5 bg-white border border-outline-variant/50 rounded-lg text-outline hover:text-red-500 hover:border-red-300 transition-all flex items-center gap-1 px-3" title="전체 탭 닫기">
                    <i data-lucide="list-x" class="w-4 h-4"></i>
                    <span class="text-[10px] font-bold uppercase tracking-tighter">Clear All</span>
                </button>
            </div>
            
            <main id="main-frame-container" class="flex-1 overflow-hidden relative bg-surface"></main>
        </div>

        <%-- COMMON CONFIRM MODAL (GENERAL) --%>
        <div id="confirm-modal" class="fixed inset-0 bg-secondary/40 backdrop-blur-sm z-[999] fouc-hidden items-center justify-center p-4">
            <div class="bg-white rounded-[2rem] p-10 max-w-[360px] w-full shadow-2xl transform transition-all scale-95 opacity-0 text-center" id="confirm-modal-content">
                <div class="w-16 h-16 bg-red-50 rounded-3xl flex items-center justify-center mb-6 mx-auto text-red-500 shadow-inner"><i data-lucide="alert-circle" id="confirm-icon" class="w-8 h-8"></i></div>
                <h3 class="text-xl font-bold text-secondary mb-3" id="confirm-title">확인</h3>
                <p class="text-xs text-on-surface-variant mb-10 font-medium leading-relaxed px-4" id="confirm-text"></p>
                <div class="flex gap-3">
                    <button type="button" onclick="hideConfirmModal()" class="flex-1 py-4 bg-surface-container-high text-on-surface font-bold rounded-2xl text-xs">취소</button>
                    <button type="button" id="btn-confirm-action" class="flex-1 py-4 bg-red-500 text-white font-bold rounded-2xl text-xs hover:bg-red-600 transition-all shadow-lg shadow-red-500/20">확인</button>
                </div>
            </div>
        </div>

        <div id="logout-modal" class="fixed inset-0 bg-black/40 z-[999] fouc-hidden items-center justify-center p-4">
            <div class="bg-white rounded-2xl p-6 max-w-[320px] w-full shadow-2xl transform transition-all scale-95 opacity-0" id="logout-modal-content">
                <h3 class="text-base font-bold text-secondary mb-2 flex items-center gap-2"><i data-lucide="log-out" class="w-5 h-5"></i>로그아웃</h3>
                <p class="text-xs text-on-surface-variant mb-6 font-medium">정말로 시스템에서 로그아웃 하시겠습니까?</p>
                <div class="flex gap-2 justify-end">
                    <button type="button" onclick="hideLogoutModal()" class="px-4 py-2 bg-surface-container-high text-on-surface font-bold rounded-lg text-xs hover:bg-surface-dim transition-all">취소</button>
                    <asp:LinkButton ID="btnLogout" runat="server" OnClick="btnLogout_Click" OnClientClick="clearTabStorage();" CssClass="px-4 py-2 bg-red-500 text-white font-bold rounded-lg text-xs hover:bg-red-600 transition-all">확인</asp:LinkButton>
                </div>
            </div>
        </div>

        <%-- COMMON ALERT MODAL --%>
        <div id="alert-modal" class="fixed inset-0 bg-secondary/60 backdrop-blur-sm z-[2000] hidden items-center justify-center p-4">
            <div class="bg-white rounded-2xl p-10 max-w-[360px] w-full shadow-2xl transform transition-all scale-95 opacity-0 text-center" id="alert-modal-content">
                <div class="w-16 h-16 bg-red-50 rounded-3xl flex items-center justify-center mb-6 mx-auto text-red-500 shadow-inner" id="alert-icon-container"><i data-lucide="alert-circle" class="w-8 h-8"></i></div>
                <h3 class="text-xl font-bold text-secondary mb-3" id="alert-title">알림</h3>
                <p class="text-xs text-on-surface-variant mb-10 px-2 font-medium" id="alert-message"></p>
                <button type="button" onclick="hideAlert()" class="w-full py-4 bg-secondary text-white font-bold rounded-2xl text-xs hover:opacity-90 transition-all shadow-lg shadow-secondary/20">확인</button>
            </div>
        </div>
        <% } else { %>
        <main class="flex-1 h-screen overflow-hidden">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </main>
        <% } %>
    </form>
    <script>
        lucide.createIcons();
        
        // 공통 로드 효과: 메인 쉘과 iframe 내부 모두 적용
        $(function() {
            setTimeout(function() {
                $('body').addClass('loaded');
            }, 50);
        });

        <% if (!IsFrame) { %>
        const TAB_STORAGE_KEY = 'partners_tabs_v2';
        let openTabs = JSON.parse(sessionStorage.getItem(TAB_STORAGE_KEY)) || [{ id: '/Dashboard.aspx', label: '대시보드' }];
        let activeTabId = sessionStorage.getItem('partners_active_tab') || '/Dashboard.aspx';
        function saveState() { sessionStorage.setItem(TAB_STORAGE_KEY, JSON.stringify(openTabs)); sessionStorage.setItem('partners_active_tab', activeTabId); }
        function openTab(id, label) { if (!openTabs.find(t => t.id === id)) { openTabs.push({ id, label }); } activeTabId = id; saveState(); renderTabs(); syncIframes(); updateSidebarActive(); }
        function syncIframes() {
            const $container = $('#main-frame-container');
            $container.find('iframe').each(function() { if (!openTabs.find(t => t.id === $(this).data('id'))) { $(this).remove(); } });
            openTabs.forEach(tab => {
                let $iframe = $container.find(`iframe[data-id="${tab.id}"]`);
                if ($iframe.length === 0) { 
                    $iframe = $(`<iframe data-id="${tab.id}" src="${tab.id + (tab.id.includes('?') ? '&' : '?') + 'frame=Y'}" 
                                 style="background: transparent;"
                                 class="absolute inset-0 w-full h-full border-none hidden opacity-0 transition-opacity duration-300"></iframe>`); 
                    $iframe.on('load', function() { $(this).removeClass('opacity-0').addClass('opacity-100'); });
                    $container.append($iframe); 
                }
                if (tab.id === activeTabId) { $iframe.removeClass('hidden'); } else { $iframe.addClass('hidden'); }
            });
        }
        function renderTabs() {
            const $container = $('#tabs-bar'); $container.empty();
            openTabs.forEach(tab => {
                const isActive = (tab.id === activeTabId);
                const $tab = $(`<div class="tab-item px-5 py-2.5 flex items-center gap-2.5 cursor-move text-xs transition-all shrink-0 overflow-hidden
                                ${isActive ? 'tab-active' : 'tab-inactive'}" 
                                data-id="${tab.id}" onclick="activateTab('${tab.id}')">
                        <span class="cursor-pointer font-semibold">${tab.label}</span>
                        ${tab.id !== '/Dashboard.aspx' ? `<i data-lucide="x" class="w-3.5 h-3.5 rounded-full p-0.5 transition-colors cursor-pointer ${isActive ? 'hover:text-red-400 hover:bg-white/10' : 'hover:text-red-500 hover:bg-red-50'}" onclick="closeTab('${tab.id}', event)"></i>` : ''}
                    </div>`);
                $container.append($tab);
            });
            lucide.createIcons(); initSortable();
        }
        function activateTab(id) { activeTabId = id; saveState(); renderTabs(); syncIframes(); updateSidebarActive(); }
        function closeTab(id, event) { if (event) event.stopPropagation(); openTabs = openTabs.filter(t => t.id !== id); if (activeTabId === id) { activeTabId = openTabs[openTabs.length - 1].id; } saveState(); renderTabs(); syncIframes(); updateSidebarActive(); }
        
        function showCloseAllModal() {
            $('#confirm-title').text('전체 탭 닫기');
            $('#confirm-text').html('대시보드를 제외한 모든 탭을 닫으시겠습니까?<br/>저장되지 않은 정보는 사라질 수 있습니다.');
            $('#confirm-modal').removeClass('hidden').addClass('flex').show();
            setTimeout(() => $('#confirm-modal-content').removeClass('scale-95 opacity-0').addClass('scale-100 opacity-100'), 10);
            $('#btn-confirm-action').off('click').on('click', closeAllTabs);
        }
        function hideConfirmModal() { 
            $('#confirm-modal-content').removeClass('scale-100 opacity-100').addClass('scale-95 opacity-0'); 
            setTimeout(() => $('#confirm-modal').addClass('hidden').removeClass('flex').hide(), 200); 
        }
        
        function closeAllTabs() {
            openTabs = [{ id: '/Dashboard.aspx', label: '대시보드' }];
            activeTabId = '/Dashboard.aspx';
            saveState();
            renderTabs();
            syncIframes();
            updateSidebarActive();
            hideConfirmModal();
        }

        function updateSidebarActive() { $('.nav-item, .nav-sub-item').removeClass('nav-active'); const $activeMenu = $(`[data-id="${activeTabId}"]`); $activeMenu.addClass('nav-active'); if ($('#sidebar').hasClass('w-64') && $activeMenu.hasClass('nav-sub-item')) { const $parentMenu = $activeMenu.closest('div[id^="submenu-"]'); if ($parentMenu.hasClass('hidden') || $parentMenu.is(':hidden')) { $parentMenu.hide().removeClass('hidden').slideDown(200); $parentMenu.prev().find('i[id^="icon-"]').addClass('rotate-180'); } } }
        function initSortable() { $("#tabs-bar").sortable({ items: ".tab-item", axis: "x", placeholder: "ui-sortable-placeholder", update: function() { const newOrder = []; $("#tabs-bar .tab-item").each(function() { const id = $(this).data("id"); newOrder.push(openTabs.find(t => t.id === id)); }); openTabs = newOrder; saveState(); } }).disableSelection(); }
        function toggleSidebar() { const $sidebar = $('#sidebar'); const $texts = $('.sidebar-text'); const isClosing = $sidebar.hasClass('w-64'); if (isClosing) { $sidebar.removeClass('w-64').addClass('w-[72px]'); $texts.hide(); $('div[id^="submenu-"]').hide(); $('i[id^="icon-"]').removeClass('rotate-180'); } else { $sidebar.removeClass('w-[72px]').addClass('w-64'); setTimeout(() => { $texts.fadeIn(100); updateSidebarActive(); }, 200); } }
        function toggleSubmenu(id) { if (!$('#sidebar').hasClass('w-64')) return; const $menu = $('#' + id); if ($menu.hasClass('fouc-hidden')) $menu.hide().removeClass('fouc-hidden'); $menu.slideToggle(200); $('#icon-' + id.replace('submenu-', '')).toggleClass('rotate-180'); }
        function showLogoutModal() { 
            $('#logout-modal').removeClass('hidden').addClass('flex').show(); 
            setTimeout(() => $('#logout-modal-content').removeClass('scale-95 opacity-0').addClass('scale-100 opacity-100'), 10); 
        }
        function hideLogoutModal() { 
            $('#logout-modal-content').removeClass('scale-100 opacity-100').addClass('scale-95 opacity-0'); 
            setTimeout(() => $('#logout-modal').addClass('hidden').removeClass('flex').hide(), 200); 
        }
        function clearTabStorage() { 
            // 탭 목록 및 활성 탭 정보 삭제
            localStorage.removeItem('partners_tabs_v2'); 
            localStorage.removeItem('partners_active_tab');
            // 세션 스토리지 등 추가적인 흔적 삭제 (필요 시)
            sessionStorage.clear();
        }
        
        $(function() { 
            applyMenuAuthority();
            renderTabs(); 
            syncIframes(); 
            updateSidebarActive(); 
        });

        // --- Menu Authority Control ---
        function applyMenuAuthority() {
            try {
                // 1. 서버에서 내려준 상세 권한 목록 (AUTH_YN 포함)
                const menuAuthList = <%= MenuAuthListJson %> || [];
                // 2. 권한이 허용된 메뉴 ID 목록
                const rawAuthMenus = <%= AuthMenusJson %> || [];
                const authMenus = rawAuthMenus.map(m => (m || '').toString().trim().toUpperCase());

                const isAuth = (id) => {
                    if (!id) return false;
                    const cleanId = id.trim().toUpperCase();
                    
                    // 대시보드(W000000)는 항상 허용
                    if (cleanId === 'W000000') return true;

                    // 1순위: 상세 권한 리스트에서 AUTH_YN 확인
                    const authItem = menuAuthList.find(m => (m.pg_id || '').trim().toUpperCase() === cleanId);
                    if (authItem) {
                        return authItem.auth_yn === 'Y';
                    }

                    // 2순위: 허용된 ID 목록에 있는지 확인
                    return authMenus.indexOf(cleanId) >= 0;
                };

                // 1. 개별 메뉴 아이템(W로 시작) 처리
                $('[data-pgid^="W"]').each(function() {
                    const $item = $(this);
                    const pgId = $item.attr('data-pgid');
                    
                    if (isAuth(pgId)) {
                        // 인라인 스타일 display:none을 제거하여 원래 CSS(flex 등) 적용되도록 함
                        $item.css('display', ''); 
                    } else {
                        $item.css('display', 'none');
                    }
                });

                // 2. 메뉴 그룹(LEVEL=1) 처리
                $('[data-level="1"]').each(function() {
                    const $group = $(this);
                    let hasVisibleChild = false;
                    
                    // 그룹 내 메뉴(W) 중 권한이 있는 메뉴가 하나라도 있으면 그룹 표시
                    $group.find('[data-pgid^="W"]').each(function() {
                        if (isAuth($(this).attr('data-pgid'))) {
                            hasVisibleChild = true;
                            return false; // break
                        }
                    });

                    if (hasVisibleChild) {
                        $group.css('display', '');
                    } else {
                        $group.css('display', 'none');
                    }
                });

                // 3. 초기 숨김 클래스(fouc-hidden) 처리
                $('.fouc-hidden').removeClass('fouc-hidden').hide();

            } catch (e) {
                console.error('[MenuAuth] Error:', e);
            }
        }

        // --- My Profile & Common Alert Functions ---
        function showAlert(msg, callback, isError = false) {
            $('#alert-message').html(msg);
            if (isError) {
                $('#alert-icon-container').removeClass('bg-primary/10 text-primary').addClass('bg-red-50 text-red-500');
                $('#alert-title').text('오류');
            } else {
                $('#alert-icon-container').removeClass('bg-red-50 text-red-500').addClass('bg-primary/10 text-primary');
                $('#alert-title').text('알림');
            }
            $('#alert-modal').removeClass('hidden').addClass('flex');
            setTimeout(() => $('#alert-modal-content').removeClass('scale-95 opacity-0').addClass('scale-100 opacity-100'), 10);
            $('#alert-modal').find('button').off('click').on('click', function() {
                hideAlert();
                if (callback) callback();
            });
        }
        function hideAlert() {
            $('#alert-modal-content').removeClass('scale-100 opacity-100').addClass('scale-95 opacity-0');
            setTimeout(() => $('#alert-modal').addClass('hidden').removeClass('flex'), 200);
        }

        function callAjaxLogin(methodName, parameters, callback) {
            $.ajax({
                type: "POST",
                url: "/Login.aspx/" + methodName,
                data: JSON.stringify(parameters),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (response) {
                    if (callback && response && response.hasOwnProperty('d')) {
                        callback(response.d);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("AJAX Error [" + methodName + "]:", error);
                    showAlert("통신 중 오류가 발생했습니다.", null, true);
                }
            });
        }

        function openMyProfile() {
            const userId = $('#my-id').val();
            callAjaxLogin("GetMyInfo", { userId: userId }, function(res) {
                if (res.success) {
                    $('#my-mobile').val(res.data.mobile_no);
                    $('#my-email').val(res.data.email);
                    $('#my-pwd').val('');
                    $('#my-pwd-confirm').val('');
                    
                    $('#modal-my-profile').removeClass('hidden').addClass('flex');
                    setTimeout(() => $('#modal-my-profile-content').removeClass('scale-95 opacity-0').addClass('scale-100 opacity-100'), 10);
                } else {
                    showAlert(res.message, null, true);
                }
            });
        }

        function closeMyProfile() {
            $('#modal-my-profile-content').removeClass('scale-100 opacity-100').addClass('scale-95 opacity-0');
            setTimeout(() => $('#modal-my-profile').addClass('hidden').removeClass('flex'), 200);
        }

        function saveMyProfile() {
            const userId = $('#my-id').val();
            const pwd = $('#my-pwd').val();
            const pwdConfirm = $('#my-pwd-confirm').val();
            const mobile = $('#my-mobile').val();
            const email = $('#my-email').val();

            if (pwd !== '' && pwd !== pwdConfirm) {
                showAlert("비밀번호가 일치하지 않습니다.", function() { $('#my-pwd-confirm').focus(); }, true);
                return;
            }

            if (mobile === '') {
                showAlert("휴대폰번호를 입력해주세요.", function() { $('#my-mobile').focus(); }, true);
                return;
            }

            const params = { userId: userId, pwd: pwd, mobile: mobile, email: email };
            callAjaxLogin("UpdateMyInfo", params, function(res) {
                if (res.success) {
                    showAlert(res.message, function() {
                        closeMyProfile();
                    });
                } else {
                    showAlert(res.message, null, true);
                }
            });
        }
        <% } %>
    </script>
</body>
</html>
