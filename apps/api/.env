# 로컬 개발용 — 자체 서버(221.141.3.91)의 MariaDB(포트 3308)에 직접 연결
DATABASE_URL="mysql://dev01:4ms1001*@221.141.3.91:3308/motopay"

# JWT 서명 키 — 운영 배포 전 반드시 강력한 랜덤 값으로 교체할 것
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
# 초 단위(숫자) — jsonwebtoken의 expiresIn 문자열 리터럴 타입("15m" 등)과 .env 문자열 타입이 안 맞는 문제를 피하려고 숫자로 통일
JWT_ACCESS_EXPIRES_IN="900"
JWT_REFRESH_EXPIRES_IN="604800"
# 비밀번호 재설정용 임시 토큰 — access/refresh와 용도가 달라 별도 시크릿 사용, 10분(600초)만 유효
JWT_RESET_SECRET="fc80fdd04487261565653d25a0bb8bb119830296e6ab14a9131047f2f0e35ec7"
JWT_RESET_EXPIRES_IN="600"

# 파트너(시공업체) 로그인 전용 토큰 — 일반고객(User) 토큰과 realm을 완전히 분리하기 위해 별도 시크릿 사용(만료시간은 access/refresh와 동일 값 재사용)
JWT_PARTNER_ACCESS_SECRET="84ec5f0b466e6c0c4a9afe5144b5478016fc84b193ba1218b7f8f229b715af5d"
JWT_PARTNER_REFRESH_SECRET="1ddd1205a45baf26de4d449fc0089b8438fffb8726b62e2bef4504071f0ae864"
JWT_PARTNER_RESET_SECRET="80565c628d4d8ee5251e6d593a3bf8685e7112250a3a21c88c0678890ad8a4b6"

PORT=3000

# 휴대폰번호 암호화(AES-256-GCM) 키 — 32바이트를 hex로 표현한 64자. 운영 배포 전 반드시 새로 생성해 교체할 것
PHONE_ENCRYPTION_KEY="b073f9b576b40eb7595d95b77f0b1c79de7c8497cc92eaba92b9ae7264953794"
# 휴대폰번호 검색용 결정적 해시(HMAC-SHA256) 키 — 암호화 키와 분리(용도별 키 분리 원칙). 32바이트 hex 64자
PHONE_HASH_KEY="daedb4271a5f5fc6efc72149463c0a49eff0517b61c4ca07ac762e9b1e6b2692"

# 카카오 REST API 키 — 주소 기반 좌표 조회용
KAKAO_REST_API_KEY="43f9edbc21e48d1646310028f7d38c49"