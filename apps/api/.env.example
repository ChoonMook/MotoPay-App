DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/motopay"

JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
# 초 단위(숫자)
JWT_ACCESS_EXPIRES_IN="900"
JWT_REFRESH_EXPIRES_IN="604800"
JWT_RESET_SECRET="change-me"
JWT_RESET_EXPIRES_IN="600"

# 파트너(시공업체) 로그인 전용 토큰 — 일반고객(User) 토큰과 realm을 완전히 분리(만료시간은 access/refresh와 동일 값 재사용)
JWT_PARTNER_ACCESS_SECRET="change-me"
JWT_PARTNER_REFRESH_SECRET="change-me"
# 파트너 비밀번호 재설정용 임시 토큰 시크릿(만료시간은 JWT_RESET_EXPIRES_IN 재사용)
JWT_PARTNER_RESET_SECRET="change-me"

# 관리자(admin-app) 로그인 전용 토큰 — User/PartnerUser 토큰과 realm을 완전히 분리(만료시간은 access/refresh와 동일 값 재사용)
JWT_ADMIN_ACCESS_SECRET="change-me"
JWT_ADMIN_REFRESH_SECRET="change-me"

PORT=3000
# 테스트서버(221.141.3.91) 배포 시에는 PORT=8092 (customer-app 8090 / partner-app 8091 / admin-app 8088과 별도 origin으로 직접 노출)

# CORS 허용 origin(쉼표구분). 미지정 시 전체 허용(로컬 개발 기본값).
# 테스트서버 배포 시: CORS_ORIGINS="http://221.141.3.91:8090,http://221.141.3.91:8091,http://221.141.3.91:8088"
# admin-app(8088) 주소를 빠뜨리면 customer-app/partner-app은 정상 접속되는데 admin-app만 로그인 시
# "서버에 연결할 수 없어요" 에러가 남(브라우저가 CORS 차단을 네트워크 실패로만 보여줌) — 실제 사례로 확인됨
CORS_ORIGINS=

# 32바이트(64자 hex) — node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"로 생성
PHONE_ENCRYPTION_KEY="change-me-64-hex-chars"
PHONE_HASH_KEY="change-me-64-hex-chars-different-from-encryption-key"

# 카카오 REST API 키 — 주소 기반 좌표 조회용
KAKAO_REST_API_KEY="your-kakao-rest-api-key"

# LG U+ 메시지허브(https://api.msghub.uplus.co.kr) — SMS/LMS 인증번호 발송 + 카카오 알림톡 발송 공용(MsgHubModule)
# BaseUrl(인증 토큰 발급용)과 ApiUrl(실제 발송용)은 서로 다른 서브도메인이니 혼동 주의
MSGHUB_BASE_URL="https://api.msghub.uplus.co.kr"
MSGHUB_API_URL="https://api-send.msghub.uplus.co.kr"
MSGHUB_API_KEY="change-me"
MSGHUB_API_PWD="change-me"
# 카카오 알림톡 발신 채널 ID — 알림톡을 아직 안 쓰면 비워둬도 됨(SMS 인증번호 발송에는 불필요)
MSGHUB_KKO_CH_ID=""
# 발송 결과 콜백(웹훅) URL — 없으면 빈 문자열로 둬도 됨
MSGHUB_CALLBACK_URL=""

# PortOne(구 아임포트) 본인인증(실명인증) API 시크릿 — 회원가입 시 이름·휴대폰번호 확정용
# storeId/channelKey는 브라우저에 노출돼도 되는 값이라 여기 없음(customer-app의 .env VITE_PORTONE_* 참고)
PORTONE_API_SECRET="change-me"
