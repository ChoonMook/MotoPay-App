// Prisma schema — MotoPay API
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// output을 커스텀 경로로 지정하면 nest build 컴파일 후 dist/에서 상대경로 깊이가 달라져 require가 깨짐
// (src/prisma/prisma.service.ts → dist/src/prisma/prisma.service.js) → 기본 node_modules/@prisma/client 사용
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// 플랫폼 관리자 / 파트너사(딜러) / 시공업체 / 공급업체 / 일반고객 — 5개 사용자 유형을 role로 구분하는 통합 사용자 테이블
enum UserRole {
  ADMIN
  PARTNER
  SHOP
  SUPPLIER
  CUSTOMER
}

model User {
  id               String   @id @default(uuid())
  username         String   @unique
  passwordHash     String
  name             String
  email            String? // apps/customer-app 회원가입 화면(SignupInfoScreen)이 이미 수집하고 있어 함께 추가
  phoneEncrypted   String? // AES-256-GCM으로 암호화된 휴대폰번호(평문 저장 안 함)
  phoneHash        String? // HMAC-SHA256 결정적 해시 — 평문 대조 없이 동일 번호 검색용(암호문은 IV가 매번 달라 검색 불가)
  profileImagePath String? // 서버 uploads/ 기준 상대경로(예: "profile/<uuid>.jpg") — 절대 URL이 아닌 경로만 저장
  role             UserRole

  // 약관 동의
  agreedTerms          Boolean @default(false) // 서비스 이용약관 동의(필수)
  agreedPrivacy        Boolean @default(false) // 개인정보 처리방침 동의(필수)
  agreedMarketingSms   Boolean @default(false) // 마케팅 SMS 수신 동의(선택)
  agreedMarketingEmail Boolean @default(false) // 마케팅 이메일 수신 동의(선택)
  agreedMarketingPush  Boolean @default(false) // 마케팅 푸시 수신 동의(선택)

  // TIMESTAMP(DATETIME 대신)로 저장 — 이 앱의 DB 커넥션은 세션 타임존을 UTC로 고정해서 쓰고,
  // 다른 DB 클라이언트(서버 기본 세션=한국시간)로 직접 열어봐도 TIMESTAMP는 세션 타임존 기준으로 자동 변환되어 보임
  lastLoginAt DateTime? @db.Timestamp(3) // 최종 로그인 일시
  withdrawnAt DateTime? @db.Timestamp(3) // 탈퇴일시(AD-MBR-02 고객 회원 목록 전용) — null이면 정상, 값이 있으면 탈퇴 상태
  createdAt   DateTime  @default(now()) @db.Timestamp(3) // 가입일시
  updatedAt   DateTime  @updatedAt @db.Timestamp(3)

  carPurchases NewCarPurchaseCustomer[] // 이 회원으로 매핑된 신차 구매 고객 정보(여러 대 구매 가능)
  cars         MyCar[] // 이 회원 소유의 내 차량 목록
  reservations Reservation[] // 이 회원이 등록한 시공 예약 목록
  bidRequests  BidRequest[] // 이 회원이 등록한 예약시공 입찰 요청 목록
  reviews      Review[] // 이 회원이 작성한 후기 목록

  @@index([phoneHash])
  @@map("users")
}

// 공통코드 마스터 — 딜러사/차량브랜드/차종/틴팅농도/시공유형 등 플랫폼 전반에서 참조하는 코드 그룹
model CommonCode {
  code      String             @id // 공통코드(pk), 예: "CAR_BRAND"
  name      String // 공통코드명, 예: "차량브랜드"
  useYn     Boolean            @default(true) // 사용여부
  details   CommonCodeDetail[]
  createdAt DateTime           @default(now()) @db.Timestamp(3)
  updatedAt DateTime           @updatedAt @db.Timestamp(3)

  @@map("common_codes")
}

// 공통코드 상세 — 마스터 코드 그룹에 속한 개별 코드값
model CommonCodeDetail {
  code       String // FK -> CommonCode.code
  detailCode String // 상세코드(pk)
  detailName String // 상세코드명
  ref1       String? // 참조1 — 예: CAR_MODEL의 소속 브랜드코드(CAR_BRAND.code)
  ref2       String? // 참조2
  sortOrder  Int      @default(0) // 표시 순서(AD-SYS-03 공통 코드 관리 화면 전용 — 기존 공개 조회 API는 이 컬럼 추가 전과 동일하게 detailCode 기준 정렬 유지)
  useYn      Boolean  @default(true) // 사용여부
  createdAt  DateTime @default(now()) @db.Timestamp(3)
  updatedAt  DateTime @updatedAt @db.Timestamp(3)

  commonCode CommonCode @relation(fields: [code], references: [code])

  @@id([code, detailCode])
  @@map("common_code_details")
}

// 관리자앱(admin-app) 로그인 계정 — 운영사/딜러사/공급업체 소속으로 관리자웹에 로그인하는 계정. 일반고객(User)·
// 시공업체(PartnerUser)와는 별도 인증 realm(admin-auth 모듈)을 사용한다.
model AdminAccount {
  id             String    @id @default(uuid())
  username       String    @unique
  passwordHash   String
  name           String
  phoneEncrypted String? // AES-256-GCM으로 암호화된 휴대폰번호(평문 저장 안 함) — User.phoneEncrypted와 동일 정책
  phoneHash      String? // HMAC-SHA256 결정적 해시 — 검색용(User.phoneHash와 동일 정책)
  email          String?
  accountType    String // 사용자유형 -> CommonCodeDetail(code='CO_TYPE': ADMIN/DEALER/SUPPLIER) — SHOP(시공업체)은 PartnerUser 전용이라 관리자 계정에는 사용하지 않음
  permGroup      String // 권한그룹 -> CommonCodeDetail(code='PERM_GROUP')의 상세코드값을 참조(고정 그룹 참조라 DB FK는 걸지 않음)
  useYn          Boolean   @default(true) // 상태(사용/비활성화)
  createdBy      String? // 이 계정을 생성한 관리자 계정의 username — 최초 시드 계정은 null
  updatedBy      String? // 이 계정을 마지막으로 수정한 관리자 계정의 username
  lastLoginAt    DateTime? @db.Timestamp(3)
  createdAt      DateTime  @default(now()) @db.Timestamp(3)
  updatedAt      DateTime  @updatedAt @db.Timestamp(3)

  @@index([phoneHash])
  @@map("admin_accounts")
}

// 권한그룹별 관리자웹 메뉴 권한(AD-SYS-05 메뉴권한관리) — 메뉴 트리 자체는 admin-app의 menuConfig.ts가
// 관리하고, 이 테이블은 (권한그룹, 메뉴 프로그램ID) 조합별 접근/읽기/수정/삭제/파일 권한 여부만 저장한다.
// 화면 구성만 우선 진행 — 실제 사이드바 노출·라우팅 가드 연동은 별도 작업 범위
model MenuPermission {
  id         String   @id @default(uuid())
  permGroup  String // 권한그룹 -> CommonCodeDetail(code='PERM_GROUP')의 상세코드값을 참조(고정 그룹 참조라 DB FK는 걸지 않음)
  menuPgId   String // 메뉴구조도(uploads/MotoPay_메뉴구조도_v1_27.xlsx)의 프로그램ID, 예: "AD-MBR-02" — menuConfig.ts의 pgId와 매핑, DB FK는 걸지 않음
  canAccess  Boolean  @default(false) // 접근권한 — 선행조건(false면 아래 4개 권한은 의미 없음)
  canRead    Boolean  @default(false) // 읽기권한
  canWrite   Boolean  @default(false) // 수정권한
  canDelete  Boolean  @default(false) // 삭제권한
  canFile    Boolean  @default(false) // 파일권한
  createdAt  DateTime @default(now()) @db.Timestamp(3)
  updatedAt  DateTime @updatedAt @db.Timestamp(3)

  @@unique([permGroup, menuPgId])
  @@map("menu_permissions")
}

// 상품정보 — 쇼핑몰/시공서비스/패키지 등 모토페이가 취급하는 모든 상품의 마스터
// prodType/brand/prodCat/dealerCode는 CommonCodeDetail(code='PROD_TYPE'|'PROD_BRAND'|'PROD_CAT'|'DEALER')의 상세코드값을 참조(고정 그룹 참조라 DB FK는 걸지 않음, CAR_MODEL.ref1과 동일한 방식)
model Product {
  id          Int      @id @default(autoincrement()) // 내부 시퀀스 — productCode 채번에만 사용, 외부엔 노출 안 함
  productCode String   @unique @db.Char(10) // 상품코드 — id를 10자리로 0-padding해 자동 채번(예: "0000000003")
  prodType    String // 상품유형 -> CommonCodeDetail(code='PROD_TYPE')
  brand       String? // 브랜드 -> CommonCodeDetail(code='PROD_BRAND') — 패키지(PKG)는 구성상품마다 브랜드가 다를 수 있어 null 허용
  prodCat     String? // 상품분류명 -> CommonCodeDetail(code='PROD_CAT') — 패키지(PKG)는 구성상품마다 분류가 다를 수 있어 null 허용
  dealerCode  String? // 딜러사 -> CommonCodeDetail(code='DEALER') — 패키지(PKG)만 값이 있음(딜러사 1곳에 귀속, GOODS/SVC는 null)
  name        String // 상품명
  price       Int // 판매가(원) — 소비자가
  originPrice Int? // 정가(할인 전 가격) — 없으면 할인 없는 상품
  supplyPrice Int? // 공급가(원) — 공급업체 매입원가. 고객에게 노출하지 않는 내부 정산용 값
  description String?  @db.Text
  imagePath   String? // 프로필 사진과 동일한 정책: 서버 uploads/ 기준 상대경로
  useYn       Boolean  @default(true) // 판매여부
  createdAt   DateTime @default(now()) @db.Timestamp(3)
  updatedAt   DateTime @updatedAt @db.Timestamp(3)

  purchases NewCarPurchaseCustomer[] // 이 패키지로 매핑된 신차 구매 고객 정보

  @@index([dealerCode])
  @@map("products")
}

// 패키지 구성상품 매핑 — 패키지(PKG) 상품이 어떤 구성상품(SVC/GOODS)들로 이루어지는지 정의(Product 자기참조)
// itemType은 CommonCodeDetail(code='BUNDLE_ITEM_TYPE')의 상세코드값을 참조(고정 그룹 참조라 DB FK는 걸지 않음, prodType과 동일한 방식)
model ProductBundleItem {
  packageCode   String // 패키지 상품코드 -> Product.productCode (prodType='PKG')
  componentCode String // 구성상품 상품코드 -> Product.productCode (prodType='SVC' 또는 'GOODS')
  itemType      String @default("BASIC") // BASIC(기본상품,무상)/OPTION(업그레이드옵션 — 같은 componentCode.prodCat 내 대체, 유상)/ADD(추가옵션 — 패키지 미포함 분류, 유상) -> CommonCodeDetail(code='BUNDLE_ITEM_TYPE')
  price         Int? // 이 패키지 안에서 구성상품에 적용하는 가격(원) — 동일 구성상품도 패키지마다 가격이 다를 수 있어 지정. null이면 Product.price를 그대로 사용
  qty           Int    @default(1) // 수량
  sortOrder     Int    @default(0) // 표시 순서

  @@id([packageCode, componentCode])
  @@map("product_bundle_items")
}

// 신차 구매 고객 정보 — 딜러사 웹에서 신차 구매 고객 정보를 등록. 고객이 모토페이 회원가입하면 고객명+휴대폰번호로 매핑(자동 매핑 로직 자체는 별도 작업)
model NewCarPurchaseCustomer {
  vin            String  @id @db.VarChar(17) // 차대번호(VIN, 17자리) — 딜러가 제공하는 자연키라 별도 채번 없이 PK로 사용
  dealerCode     String // 딜러사코드 -> CommonCodeDetail(code='DEALER')
  customerName   String // 고객명
  phoneEncrypted String // 휴대폰번호(AES-256-GCM 암호화) — User.phoneEncrypted와 동일 정책
  phoneHash      String // 회원가입 시 이름+휴대폰 매핑 조회용 해시 — User.phoneHash와 동일 정책
  carBrandCode   String // 차량브랜드코드 -> CommonCodeDetail(code='CAR_BRAND')
  carModelCode   String // 차종코드 -> CommonCodeDetail(code='CAR_MODEL')
  trimName       String // 세부차종명(자유 텍스트, 예: "E 200")
  modelYear      String? // 연식 — 딜러가 등록 시점에 받을 수 있으면 채움(신차매핑된 MyCar.modelYear로 그대로 복사)
  packageCode    String? // 패키지상품코드 -> Product.productCode(prodType='PKG')

  isMapped Boolean   @default(false) // 매핑여부
  mappedAt DateTime? @db.Timestamp(3) // 매핑일시
  memberId String? // 매핑된 회원id -> User.id

  createdBy String? // 등록자id — 딜러사 직원 계정(파트너 로그인)이 아직 없어 FK 없이 문자열로만 보관
  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedBy String? // 수정자id
  updatedAt DateTime @updatedAt @db.Timestamp(3)

  package       Product?             @relation(fields: [packageCode], references: [productCode])
  member        User?                @relation(fields: [memberId], references: [id])
  myCars        MyCar[] // 이 구매정보로 생성된 내 차량 정보(신차매핑)
  selectedItems NewCarPurchaseItem[] // 이 구매건에서 실제 선택한 업그레이드옵션·추가옵션(기본상품은 항상 포함이라 별도 기록 안 함)

  @@index([phoneHash])
  @@map("new_car_purchase_customers")
}

// 신차 구매 고객이 패키지 구성상품 중 실제로 선택한 업그레이드옵션(OPTION)·추가옵션(ADD)만 기록
// (ProductBundleItem은 패키지의 카탈로그 정의일 뿐, 이 구매건에서 실제 적용된 항목은 이 테이블로 별도 관리)
// 기본상품(BASIC)은 항상 포함되므로 여기 기록하지 않음 — 파트너앱 시공상세는 기본상품 전체 + 이 테이블에 있는 항목만 표시
model NewCarPurchaseItem {
  vin           String // 구매정보 -> NewCarPurchaseCustomer.vin
  componentCode String // 선택한 구성상품 -> Product.productCode

  purchase NewCarPurchaseCustomer @relation(fields: [vin], references: [vin])

  @@id([vin, componentCode])
  @@map("new_car_purchase_items")
}

// 내 차량 정보 — 회원이 보유한 차량 목록. 신차 구매 매핑 시 자동 생성되거나(regType='MAP') 고객이 직접 등록(regType='MANUAL')
model MyCar {
  id           Int      @id @default(autoincrement())
  memberId     String // 소유 회원 -> User.id
  regType      String // 등록구분 -> CommonCodeDetail(code='CAR_REG_TYPE': MAP=신차매핑/MANUAL=수기등록)
  purchaseVin  String? // 신차 구매정보 연결 -> NewCarPurchaseCustomer.vin(신차매핑인 경우만)
  dealerCode   String? // 딜러사코드 -> CommonCodeDetail(code='DEALER') — 신차매핑 시 구매정보에서 그대로 복사, 수기등록은 null
  carBrandCode String // 차량브랜드코드 -> CommonCodeDetail(code='CAR_BRAND')
  carModelCode String // 차종코드 -> CommonCodeDetail(code='CAR_MODEL')
  trimName     String? // 세부차종명
  modelYear    String? // 연식 — 신차매핑 시 NewCarPurchaseCustomer.modelYear가 있으면 그대로 복사, 없으면 고객이 직접 입력
  plateNumber  String? // 차량번호 — 출고 직후엔 번호판 미배정일 수 있어 nullable
  vin          String? // 차대번호
  isDefault    Boolean  @default(false) // 대표차량여부
  createdAt    DateTime @default(now()) @db.Timestamp(3)
  updatedAt    DateTime @updatedAt @db.Timestamp(3)

  member      User                    @relation(fields: [memberId], references: [id])
  purchase    NewCarPurchaseCustomer? @relation(fields: [purchaseVin], references: [vin])
  bidRequests BidRequest[] // 이 차량으로 등록된 예약시공 입찰 요청 목록

  @@index([memberId])
  @@map("my_cars")
}

// 시공업체 마스터 — 틴팅/블랙박스/코팅 등 시공을 수행하는 업체 정보
model Shop {
  id            Int      @id @default(autoincrement()) // 내부 시퀀스 — shopCode 채번에만 사용, 외부엔 노출 안 함
  shopCode      String   @unique @db.Char(10) // 업체코드 — id를 10자리로 0-padding해 자동 채번(Product.productCode와 동일 방식)
  name          String // 업체명
  greeting      String?  @db.Text // 인사말
  intro         String?  @db.Text // 소개
  zipCode       String? // 우편번호
  address       String? // 주소
  addressDetail String? // 상세주소
  latitude      Float? // 위도 — 지도 표시·거리 계산용, 주소 등록 후 지오코딩으로 채움
  longitude     Float? // 경도
  phone         String? // 대표전화번호
  businessHours String? // 운영시간 안내(자유 텍스트, 예: "평일 09:00 ~ 19:00, 토요일 10:00 ~ 18:00, 일요일 휴무")
  useYn         Boolean  @default(true) // 사용여부
  createdAt     DateTime @default(now()) @db.Timestamp(3)
  updatedAt     DateTime @updatedAt @db.Timestamp(3)

  photos         ShopPhoto[]
  categories     ShopInstCategory[]
  holidays       ShopHoliday[]
  timeSlots      ShopTimeSlot[]
  dailySlots     ShopDailySlot[]
  reservations   Reservation[]
  partnerUsers   PartnerUser[]
  bidInvitations BidInvitation[]
  bidOffers      BidOffer[]
  bidPlans       BidPlan[]
  reviews        Review[]
  company        Company? // AD-CO 업체 관리에서 이 시공업체에 연결한 업체(사업자) 레코드

  @@map("shops")
}

// 업체 마스터(AD-CO-02/03/04 업체 관리) — 딜러사·시공업체·공급업체를 통합 관리하는 업체 레코드.
// 시공업체(coType='SHOP')는 기존 Shop 테이블과 shopCode로 연결(운영 데이터는 Shop에 그대로 유지, 이 테이블은
// 사업자 정보·상태만 관리). 딜러사·공급업체는 아직 별도 운영 테이블이 없어 이 테이블이 유일한 레코드다.
model Company {
  id                   Int       @id @default(autoincrement())
  coType               String // 업체구분 -> CommonCodeDetail(code='CO_TYPE': DEALER/SHOP/SUPPLIER)
  name                 String // 업체명
  businessRegNo        String // 사업자번호
  representativeName   String? // 대표자명
  contactName          String? // 담당자명
  contactPhone         String? // 담당자 연락처
  shopCode             String?   @unique @db.Char(10) // coType='SHOP'인 경우 Shop.shopCode 연결(1:1), 그 외 타입은 null
  useYn                Boolean   @default(true) // 상태(정상=true/중지=false)
  suspendReason        String?   @db.Text // 사용중지 사유(중지 처리 시 필수 입력)
  companyZipCode       String? // 회사주소(사업자 등록 주소) 우편번호
  companyAddress       String? // 회사주소
  companyAddressDetail String? // 회사주소 상세
  businessType         String? // 업태
  businessItem         String? // 종목
  bizDivision          String? // 사업자구분 -> CommonCodeDetail(code='BIZ_DIV': INDIVIDUAL/CORP)
  repPhone             String? // 대표전화번호
  faxNo                String? // 팩스번호
  bankName             String? // 정산 입금 은행명
  accountNo            String? // 정산 입금 계좌번호
  bizRegCertPath       String? // 사업자 등록증 첨부 파일 경로(uploadsRoot 기준 상대경로, 이미지 또는 PDF)
  bankbookCopyPath     String? // 통장사본 첨부 파일 경로(uploadsRoot 기준 상대경로, 이미지 또는 PDF)
  approved             Boolean   @default(false) // 승인여부 — true여야 소속 로그인 계정(PartnerUser 등)이 정상 로그인 가능
  approvedAt           DateTime? @db.Timestamp(3) // 승인일시
  approvedBy           String? // 승인 처리한 관리자 계정의 username
  createdAt            DateTime  @default(now()) @db.Timestamp(3)
  updatedAt            DateTime  @updatedAt @db.Timestamp(3)

  shop Shop? @relation(fields: [shopCode], references: [shopCode])

  @@map("companies")
}

// 파트너(시공업체) 사용자 — apps/partner-app 로그인 계정. 자체 가입 없이 콜센터 등을 통해 발급되며, 발급 직후에는
// 반드시 최초 비밀번호 변경을 거쳐야 함(mustChangePassword). User(일반고객) 테이블과는 완전히 분리된 별도 로그인 realm.
model PartnerUser {
  id                 String    @id @default(uuid())
  username           String    @unique
  passwordHash       String
  name               String // 담당자명
  phoneEncrypted     String // AES-256-GCM으로 암호화된 휴대폰번호(평문 저장 안 함) — User.phoneEncrypted와 동일 정책
  phoneHash          String // HMAC-SHA256 결정적 해시 — 검색용(User.phoneHash와 동일 정책)
  email              String // 알림 수신용 이메일
  shopCode           String    @db.Char(10) // 소속 업체 -> Shop.shopCode
  mustChangePassword Boolean   @default(true) // 최초 로그인 시 true — 비밀번호 변경 완료 시 false로 전환
  useYn              Boolean   @default(true) // 사용여부(퇴사 등으로 인한 계정 비활성화)
  lastLoginAt        DateTime? @db.Timestamp(3) // 최종 로그인 일시
  createdAt          DateTime  @default(now()) @db.Timestamp(3) // 계정 발급일시
  updatedAt          DateTime  @updatedAt @db.Timestamp(3)

  shop Shop @relation(fields: [shopCode], references: [shopCode])

  @@index([phoneHash])
  @@index([shopCode])
  @@map("partner_users")
}

// 시공업체 사진 — 대표사진(MAIN)/시공 사례(CASE) 등 용도별로 여러 장 등록
// photoType은 CommonCodeDetail(code='SHOP_PHOTO_TYPE')의 상세코드값을 참조(고정 그룹 참조라 DB FK는 걸지 않음, prodType과 동일한 방식)
model ShopPhoto {
  id        Int      @id @default(autoincrement())
  shopCode  String // 소속 업체 -> Shop.shopCode
  photoPath String // 서버 uploads/ 기준 상대경로
  photoType String // 사진유형(MAIN=대표사진/CASE=시공사례) -> CommonCodeDetail(code='SHOP_PHOTO_TYPE')
  sortOrder Int      @default(0) // 표시 순서
  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @updatedAt @db.Timestamp(3)

  shop Shop @relation(fields: [shopCode], references: [shopCode])

  @@index([shopCode])
  @@map("shop_photos")
}

// 시공업체 시공가능 카테고리 매핑 — 업체가 지원하는 자동차 시공 항목을 정의
// instCode는 CommonCodeDetail(code='CAR_INST')의 상세코드값을 참조(고정 그룹 참조라 DB FK는 걸지 않음, prodType과 동일한 방식)
model ShopInstCategory {
  shopCode String // 업체코드 -> Shop.shopCode
  instCode String // 자동차 시공코드 -> CommonCodeDetail(code='CAR_INST')

  shop Shop @relation(fields: [shopCode], references: [shopCode])

  @@id([shopCode, instCode])
  @@map("shop_inst_categories")
}

// 시공업체 휴무일 — 행이 존재하면 해당 일자는 휴무(고객앱 시공 일정 예약에서 선택 불가)
model ShopHoliday {
  shopCode    String // 업체코드 -> Shop.shopCode
  holidayDate DateTime @db.Date // 휴무 일자

  shop Shop @relation(fields: [shopCode], references: [shopCode])

  @@id([shopCode, holidayDate])
  @@map("shop_holidays")
}

// 시공업체 예약가능 시간대 템플릿 — 요일구분별 반복되는 기본 시간대·정원
// dayType은 CommonCodeDetail(code='SHOP_DAY_TYPE')의 상세코드값을 참조(고정 그룹 참조라 DB FK는 걸지 않음, prodType과 동일한 방식)
model ShopTimeSlot {
  shopCode String // 업체코드 -> Shop.shopCode
  dayType  String // 요일구분(WEEKDAY/SAT/SUN/HOLIDAY) -> CommonCodeDetail(code='SHOP_DAY_TYPE')
  time     DateTime @db.Time(0) // 예약 시간
  capacity Int // 예약 가능 대수

  shop Shop @relation(fields: [shopCode], references: [shopCode])

  @@id([shopCode, dayType, time])
  @@map("shop_time_slots")
}

// 시공업체 일자별 예약 슬롯 오버라이드 — 특정 날짜·시간에 한해 템플릿(ShopTimeSlot)과 다른 정원을 적용하거나 잠글 때만 행이 생김
model ShopDailySlot {
  shopCode String // 업체코드 -> Shop.shopCode
  date     DateTime @db.Date // 예약 일자
  time     DateTime @db.Time(0) // 예약 시간
  capacity Int? // 이 날짜·시간 한정 정원 — null이면 ShopTimeSlot 템플릿값을 그대로 사용
  isLocked Boolean  @default(false) // 잠금 처리 여부(예약 불가)

  shop Shop @relation(fields: [shopCode], references: [shopCode])

  @@id([shopCode, date, time])
  @@map("shop_daily_slots")
}

// 시공 예약 — 고객이 시공업체의 특정 일자·시간에 등록한 예약 건
// reservationType/status/progressStatus/cancelReason은 각각 CommonCodeDetail(code='RESERVATION_TYPE'/'RESERVATION_STATUS'/'RESERVATION_PROGRESS'/'CANCEL_REASON')의
// 상세코드값을 참조(고정 그룹 참조라 DB FK는 걸지 않음, prodType과 동일한 방식)
model Reservation {
  id                  Int       @id @default(autoincrement()) // 내부 시퀀스 — reservationNo 채번에만 사용, 외부엔 노출 안 함
  reservationNo       String    @unique @db.Char(10) // 예약번호 — id를 10자리로 0-padding해 자동 채번(Product/Shop과 동일 방식)
  shopCode            String // 시공업체 -> Shop.shopCode
  date                DateTime  @db.Date // 예약 일자
  time                DateTime  @db.Time(0) // 예약 시간
  seq                 Int // 같은 shopCode+date+time 내 순번(1부터)
  reservationType     String // 예약유형(PKG=신차패키지/BID=일반입찰) -> CommonCodeDetail(code='RESERVATION_TYPE')
  memberId            String // 예약 고객 -> User.id
  status              String    @default("CONFIRMED") // 예약상태(CONFIRMED/CANCELLED) -> CommonCodeDetail(code='RESERVATION_STATUS')
  progressStatus      String    @default("APPLIED") // 시공 진행상태(APPLIED=신청/IN_PROGRESS=시공중/DONE=시공완료) -> CommonCodeDetail(code='RESERVATION_PROGRESS')
  cancelReason        String? // 취소 사유 -> CommonCodeDetail(code='CANCEL_REASON') — 취소된 건만 값 존재
  cancelReasonEtc     String?   @db.Text // 취소 사유가 기타(ETC)일 때의 자유 입력 텍스트
  cancelledAt         DateTime? @db.Timestamp(3) // 취소 처리 일시
  completionMemo      String?   @db.Text // 시공 완료 등록 시 파트너가 남긴 작업 메모(선택)
  completedAt         DateTime? @db.Timestamp(3) // 시공 완료 처리 일시 — progressStatus가 DONE으로 바뀐 시점
  handoverConfirmedAt DateTime? @db.Timestamp(3) // 고객 인수확인 일시 — 직접 확인하거나, completedAt+3일 경과 시 자동 확정된 시점
  requestNo           String?   @db.Char(10) // reservationType='BID'인 건만 값 존재 -> BidRequest.requestNo(낙찰되어 생성된 예약)
  createdAt           DateTime  @default(now()) @db.Timestamp(3)
  updatedAt           DateTime  @updatedAt @db.Timestamp(3)

  shop     Shop                 @relation(fields: [shopCode], references: [shopCode])
  member   User                 @relation(fields: [memberId], references: [id])
  request  BidRequest?          @relation(fields: [requestNo], references: [requestNo])
  photos   ReservationPhoto[] // 시공 완료 등록 시 첨부한 시공 사진(고객 인수확인 화면에 그대로 노출)
  callLogs ReservationCallLog[] // 파트너가 남긴 해피콜(고객 통화) 이력
  review   Review? // 인수확인 후 고객이 남긴 후기 — 예약당 1건

  @@index([shopCode, date, time])
  @@map("reservations")
}

// 시공 완료 등록(PT-NCPK-04) 시 첨부하는 시공 사진 — 고객 인수확인 화면(CU-RSVC-16)에 그대로 노출됨
model ReservationPhoto {
  id            Int      @id @default(autoincrement())
  reservationNo String // 소속 예약 -> Reservation.reservationNo
  photoPath     String // 서버 uploads/ 기준 상대경로
  sortOrder     Int      @default(0) // 표시 순서
  createdAt     DateTime @default(now()) @db.Timestamp(3)

  reservation Reservation @relation(fields: [reservationNo], references: [reservationNo])

  @@index([reservationNo])
  @@map("reservation_photos")
}

// 파트너가 예약 건 고객에게 건 해피콜(확인 전화) 이력(PT-RSVC-03) — 통화 결과·메모를 남겨 언제든 재확인 가능
model ReservationCallLog {
  id            Int      @id @default(autoincrement())
  reservationNo String // 소속 예약 -> Reservation.reservationNo
  result        String // 통화 결과 -> CommonCodeDetail(code='CALL_RESULT')
  memo          String?  @db.Text
  createdAt     DateTime @default(now()) @db.Timestamp(3)

  reservation Reservation @relation(fields: [reservationNo], references: [reservationNo])

  @@index([reservationNo])
  @@map("reservation_call_logs")
}

// 인수확인 후 고객이 남기는 시공업체 후기(CU-RSVC-17) — 예약 1건당 1건, 신차패키지·예약시공 등 reservationType 공용
model Review {
  id            Int      @id @default(autoincrement())
  reservationNo String   @unique @db.Char(10) // 소속 예약 -> Reservation.reservationNo, 예약당 후기 1건
  memberId      String // 작성자 -> User.id
  shopCode      String // 대상 업체 -> Shop.shopCode(업체별 후기 집계·조회용)
  rating        Int // 평점 1~5
  content       String   @db.Text
  createdAt     DateTime @default(now()) @db.Timestamp(3)
  updatedAt     DateTime @updatedAt @db.Timestamp(3)

  reservation Reservation   @relation(fields: [reservationNo], references: [reservationNo])
  member      User          @relation(fields: [memberId], references: [id])
  shop        Shop          @relation(fields: [shopCode], references: [shopCode])
  photos      ReviewPhoto[]

  @@index([shopCode])
  @@map("reviews")
}

// 후기에 첨부한 사진
model ReviewPhoto {
  id        Int      @id @default(autoincrement())
  reviewId  Int
  photoPath String // 서버 uploads/ 기준 상대경로
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamp(3)

  review Review @relation(fields: [reviewId], references: [id])

  @@index([reviewId])
  @@map("review_photos")
}

// 예약시공(CU-RSVC) 입찰 요청 — 일반입찰/전문가추천 공용. 낙찰 전까지는 실제 예약 슬롯이 아니라 "요청"일 뿐이며,
// 낙찰되면 별도로 Reservation(reservationType='BID')이 생성된다(1단계 범위 밖)
model BidRequest {
  id               Int      @id @default(autoincrement()) // 내부 시퀀스 — requestNo 채번에만 사용
  requestNo        String   @unique @db.Char(10) // 요청번호 — id를 10자리로 0-padding(Reservation과 동일 방식)
  memberId         String // 요청 고객 -> User.id
  myCarId          Int? // 요청 시점 회원 대표차량 스냅샷 -> MyCar.id — 화면 입력값 아님, 생성 시 서버가 MyCar.isDefault=true를 자동 연결(미등록 회원은 null)
  reqType          String // 요청유형(GENERAL=일반입찰/EXPERT=전문가추천) -> CommonCodeDetail(code='BID_REQ_TYPE')
  status           String   @default("OPEN") // 요청상태 -> CommonCodeDetail(code='BID_REQ_STATUS') — 1단계는 OPEN만 생성(라이프사이클 전체는 시드에 등록됨)
  desiredDate      DateTime @db.Date // 희망 시공일 — 실제 예약 슬롯이 아니라 "희망 힌트"일 뿐, 낙찰 후 별도로 실제 일정을 잡아야 함
  radiusKm         Int // 검색 반경(km) — 회원 위치 좌표가 시스템에 아직 없어 1단계는 값만 보존(거리 계산 미사용)
  minRating        Float? // 최소 평점 조건(0~5, 선택)
  budget           Int? // 희망 예산(EXPERT 전용)
  note             String?  @db.Text // 요청사항(EXPERT 전용)
  bidDeadline      DateTime @default(now()) @db.Timestamp(3) // 입찰 마감 일시 — 항상 서비스 코드가 createdAt+1일로 명시 계산해 넣음(정책 미정 상태의 임시 상수).
  // @default(now())는 실사용되지 않는 안전장치일 뿐 — explicit_defaults_for_timestamp=OFF인 이 서버가 명시적
  // DEFAULT가 없는 첫 TIMESTAMP 컬럼에 자동으로 DEFAULT+ON UPDATE CURRENT_TIMESTAMP를 부여해버려서(다른 컬럼
  // 수정만으로도 값이 조용히 바뀌는 버그가 생김), 명시적 DEFAULT를 선언해 그 자동부여 대상에서 빼기 위함
  cancelReason     String? // 취소사유 -> CommonCodeDetail(code='BID_CANCEL_REASON') — 취소(CANCELLED) 시에만 값 존재
  cancelReasonNote String?  @db.Text // 취소사유가 기타(ETC)일 때의 자유입력 사유
  selectedOfferNo  String?  @db.Char(10) // 고객이 선택한 응찰(GENERAL) -> BidOffer.offerNo — 선택(SELECTED) 시에만 값 존재
  selectedPlanNo   String?  @db.Char(10) // 고객이 선택한 추천안(EXPERT) -> BidPlan.planNo — 선택(SELECTED) 시에만 값 존재
  createdAt        DateTime @default(now()) @db.Timestamp(3)
  updatedAt        DateTime @updatedAt @db.Timestamp(3)

  member       User                 @relation(fields: [memberId], references: [id])
  myCar        MyCar?               @relation(fields: [myCarId], references: [id])
  items        BidRequestItem[]
  positions    BidRequestPosition[]
  invitations  BidInvitation[]
  offers       BidOffer[]
  plans        BidPlan[]
  reservations Reservation[]

  @@index([memberId])
  @@map("bid_requests")
}

// 업체가 예약시공 요청에 제출한 입찰(일반입찰 GENERAL 전용 — 전문가추천의 추천안은 별도 도메인, 미구현)
model BidOffer {
  id            Int      @id @default(autoincrement()) // 내부 시퀀스 — offerNo 채번에만 사용
  offerNo       String   @unique @db.Char(10) // 응찰번호 — id를 10자리로 0-padding(BidRequest.requestNo와 동일 방식)
  requestNo     String   @db.Char(10) // 대상 요청 -> BidRequest.requestNo
  shopCode      String // 응찰 업체 -> Shop.shopCode
  scheduledTime DateTime @db.Time(0) // 시공 예정 시각 — 날짜는 항상 BidRequest.desiredDate와 동일(파트너는 그 날짜의 업체 실제 슬롯 중에서만 선택 가능)
  memo          String?  @db.Text
  createdAt     DateTime @default(now()) @db.Timestamp(3)
  updatedAt     DateTime @updatedAt @db.Timestamp(3)

  request BidRequest     @relation(fields: [requestNo], references: [requestNo])
  shop    Shop           @relation(fields: [shopCode], references: [shopCode])
  items   BidOfferItem[]

  @@unique([requestNo, shopCode]) // 요청당 업체는 1회만 응찰 가능
  @@index([requestNo])
  @@map("bid_offers")
}

// 응찰 항목별 견적 — BidRequestItem과 instCode로 1:1 대응(고객이 요청한 시공 항목별로 업체가 각각 가격을 매김)
model BidOfferItem {
  offerNo  String @db.Char(10) // 소속 응찰 -> BidOffer.offerNo
  instCode String // 시공 항목 -> CommonCodeDetail(code='CAR_INST')
  price    Int // 이 항목의 견적가(원)

  offer BidOffer @relation(fields: [offerNo], references: [offerNo])

  @@id([offerNo, instCode])
  @@map("bid_offer_items")
}

// 업체가 전문가추천(EXPERT) 요청에 제출한 추천안 — BidOffer와 별도 도메인(상품·부위/농도·추천사유를 함께 제안)
model BidPlan {
  id            Int      @id @default(autoincrement()) // 내부 시퀀스 — planNo 채번에만 사용
  planNo        String   @unique @db.Char(10) // 추천번호 — id를 10자리로 0-padding(BidOffer.offerNo와 동일 방식)
  requestNo     String   @db.Char(10) // 대상 요청 -> BidRequest.requestNo
  shopCode      String // 추천 업체 -> Shop.shopCode
  scheduledTime DateTime @db.Time(0) // 시공 예정 시각 — 날짜는 항상 BidRequest.desiredDate와 동일(BidOffer와 동일 관례)
  reason        String   @db.Text // 추천 사유
  createdAt     DateTime @default(now()) @db.Timestamp(3)
  updatedAt     DateTime @updatedAt @db.Timestamp(3)

  request   BidRequest        @relation(fields: [requestNo], references: [requestNo])
  shop      Shop              @relation(fields: [shopCode], references: [shopCode])
  items     BidPlanItem[]
  positions BidPlanPosition[]

  @@unique([requestNo, shopCode]) // 요청당 업체는 1건만 추천 제출 가능(재제출은 upsert)
  @@index([requestNo])
  @@map("bid_plans")
}

// 추천 항목별 상품·가격 — BidRequestItem과 instCode로 1:1 대응
model BidPlanItem {
  planNo      String  @db.Char(10) // 소속 추천안 -> BidPlan.planNo
  instCode    String // 시공 항목(관심 카테고리) -> CommonCodeDetail(code='CAR_INST')
  productCode String? // 추천 상품 -> Product.productCode(카탈로그에서 고른 경우, 없으면 자유 입력 상품이라 null)
  productName String // 상품명 스냅샷 — 이후 상품정보가 바뀌어도 추천안 내용은 고정되도록 항상 저장
  retailPrice Int // 소비자가(정가, 원)
  offerPrice  Int // 제안가(원)

  plan BidPlan @relation(fields: [planNo], references: [planNo])

  @@id([planNo, instCode])
  @@map("bid_plan_items")
}

// 추천안 중 틴팅(썬팅) 항목의 부위별 농도 제안 — BidRequestPosition과 동일 코드체계
model BidPlanPosition {
  planNo   String @db.Char(10) // 소속 추천안 -> BidPlan.planNo
  position String // 시공 부위 -> CommonCodeDetail(code='BID_TINT_POSITION')
  level    String // 틴팅 농도 -> CommonCodeDetail(code='VLT')

  plan BidPlan @relation(fields: [planNo], references: [planNo])

  @@id([planNo, position])
  @@map("bid_plan_positions")
}

// 요청 생성 시 시공 항목(instCode)이 일치하는 업체에게 자동 발송되는 입찰의뢰 매핑 — 페이로드 없는 순수 매핑 테이블
// (반경(radiusKm) 조건은 회원 위치 좌표가 없어 매칭에 미사용 — 시공 항목 일치 여부만으로 매칭)
model BidInvitation {
  requestNo String   @db.Char(10) // 대상 요청 -> BidRequest.requestNo
  shopCode  String // 의뢰 대상 업체 -> Shop.shopCode
  createdAt DateTime @default(now()) @db.Timestamp(3) // 의뢰(매칭) 발생 일시

  request BidRequest @relation(fields: [requestNo], references: [requestNo])
  shop    Shop       @relation(fields: [shopCode], references: [shopCode])

  @@id([requestNo, shopCode])
  @@index([shopCode])
  @@map("bid_invitations")
}

// 일반입찰 시공항목 또는 전문가추천 관심카테고리(둘 다 CAR_INST 코드계 공용, reqType으로 배타 구분해 사용)
model BidRequestItem {
  requestNo   String  @db.Char(10) // 소속 요청 -> BidRequest.requestNo
  instCode    String // 시공 항목/관심 카테고리 -> CommonCodeDetail(code='CAR_INST')
  productName String? // 선택한 제품명 스냅샷(일반입찰만, 카탈로그 미연동) — 추후 productCode 컬럼을 추가해도 이 컬럼은 표시용 스냅샷으로 유지 예정

  request BidRequest @relation(fields: [requestNo], references: [requestNo])

  @@id([requestNo, instCode])
  @@map("bid_request_items")
}

// 일반입찰 중 틴팅(썬팅) 항목을 선택했을 때의 부위별 농도
model BidRequestPosition {
  requestNo String @db.Char(10) // 소속 요청 -> BidRequest.requestNo
  position  String // 시공 부위 -> CommonCodeDetail(code='BID_TINT_POSITION')
  level     String // 틴팅 농도 -> CommonCodeDetail(code='VLT') — 신차패키지(PosLvlSelScreen 공용)와 코드그룹 공유

  request BidRequest @relation(fields: [requestNo], references: [requestNo])

  @@id([requestNo, position])
  @@map("bid_request_positions")
}
