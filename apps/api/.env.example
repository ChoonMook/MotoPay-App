DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/motopay"

JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
# 초 단위(숫자)
JWT_ACCESS_EXPIRES_IN="900"
JWT_REFRESH_EXPIRES_IN="604800"
JWT_RESET_SECRET="change-me"
JWT_RESET_EXPIRES_IN="600"

# 파트너(시공업체) 로그인 전용 토큰 — 일반고객(User) 토큰과 realm을 완전히 분리(만료시간은 access/refresh와 동일 값 재사용)
JWT_PARTNER_ACCESS_SECRET="change-me"
JWT_PARTNER_REFRESH_SECRET="change-me"
# 파트너 비밀번호 재설정용 임시 토큰 시크릿(만료시간은 JWT_RESET_EXPIRES_IN 재사용)
JWT_PARTNER_RESET_SECRET="change-me"

# 관리자(admin-app) 로그인 전용 토큰 — User/PartnerUser 토큰과 realm을 완전히 분리(만료시간은 access/refresh와 동일 값 재사용)
JWT_ADMIN_ACCESS_SECRET="change-me"
JWT_ADMIN_REFRESH_SECRET="change-me"

PORT=3000
# 테스트서버(221.141.3.91) 배포 시에는 PORT=8092 (customer-app 8090 / partner-app 8091과 별도 origin으로 직접 노출)

# CORS 허용 origin(쉼표구분). 미지정 시 전체 허용(로컬 개발 기본값).
# 테스트서버 배포 시: CORS_ORIGINS="http://221.141.3.91:8090,http://221.141.3.91:8091"
CORS_ORIGINS=

# 32바이트(64자 hex) — node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"로 생성
PHONE_ENCRYPTION_KEY="change-me-64-hex-chars"
PHONE_HASH_KEY="change-me-64-hex-chars-different-from-encryption-key"

# 카카오 REST API 키 — 주소 기반 좌표 조회용
KAKAO_REST_API_KEY="your-kakao-rest-api-key"
